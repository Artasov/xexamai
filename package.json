{
  "name": "xexamai",
  "version": "3.1.0",
  "description": "AI Interview Assistant",
  "author": "xexamai",
  "license": "MPL-2.0",
  "scripts": {
    "deps:patch": "node ./scripts/patch-axios-freeze-prototype.mjs",
    "postinstall": "npm run deps:patch",
    "predev": "npm run deps:patch",
    "predev:renderer": "npm run deps:patch",
    "prebuild": "npm run deps:patch",
    "prebuild:renderer": "npm run deps:patch",
    "pretauri": "node ./scripts/sync-tauri-version.mjs",
    "bindings:generate": "cargo test --manifest-path src-tauri/Cargo.toml --locked ipc_contract::tests::export_bindings -- --ignored --exact --nocapture",
    "bindings:check": "cargo test --manifest-path src-tauri/Cargo.toml --locked ipc_contract::tests::generated_bindings_are_current -- --exact",
    "version": "node ./scripts/sync-tauri-version.mjs && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "deps:install": "npm ci",
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite --config vite.config.mts",
    "build:renderer": "vite build --config vite.config.mts",
    "preview": "vite preview --config vite.config.mts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "release:check": "npm run bindings:check && npm run lint && npm test && npm run build:renderer",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "sass": "1.103.1",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@noble/hashes": "2.3.0",
    "@tauri-apps/api": "2.11.1",
    "axios": "1.19.0",
    "marked": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "10.0.6"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-win32-x64-msvc": "2.11.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true
  }
}
